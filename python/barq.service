# ─── BARQ Python Backend — systemd Service ──────────────────────────
# Place at: /etc/systemd/system/barq.service
# Enable:   sudo systemctl enable barq.service
# Start:    sudo systemctl start barq.service
# Logs:     sudo journalctl -u barq -f
# ─────────────────────────────────────────────────────────────────────

[Unit]
Description=BARQ Python Backend (FastAPI Sidecar)
Documentation=https://github.com/barq-ai/barq
After=network-online.target caddy.service
Wants=network-online.target

[Service]
Type=simple

# ── User & Working Directory ──
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/barq/python

# ── Environment ──
Environment=PATH=/home/ubuntu/venv/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
Environment=PYTHONUNBUFFERED=1
Environment=HOME=/home/ubuntu

# ── Start Command ──
ExecStart=/home/ubuntu/venv/bin/uvicorn main:app \
    --host 0.0.0.0 \
    --port 8970 \
    --log-level info \
    --limit-max-requests 10000

# ── Restart Policy ──
Restart=always
RestartSec=5
StartLimitInterval=300
StartLimitBurst=10

# ── Resource Limits (Oracle Free Tier: 24 GB RAM, 4 cores) ──
# FastAPI (~200 MB) + Playwright (~700 MB) + headroom = 8 GB max
MemoryMax=8G
MemoryHigh=6G
CPUQuota=300%

# ── Security Hardening ──
NoNewPrivileges=true
ProtectSystem=full
PrivateTmp=true
ProtectHome=false         # BARQ needs access to /home/ubuntu/barq
ReadWritePaths=/home/ubuntu/barq/python /var/log

# ── File Descriptors ──
LimitNOFILE=65536
LimitNPROC=4096

[Install]
WantedBy=multi-user.target
