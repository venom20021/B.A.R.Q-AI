# ─── BARQ Production Environment (Fly.io Secrets) ─────────────────────
# Set these with: fly secrets set KEY=VALUE
#
# Secrets are encrypted at rest and injected as env vars.
# Do NOT commit this file — it's a template only.
# ───────────────────────────────────────────────────────────────────────

# === REQUIRED: Database (Turso) ===
TURSO_DATABASE_URL=https://your-org.aws-region.turso.io
TURSO_AUTH_TOKEN=your_turso_auth_token_here

# === REQUIRED: Cloud LLM (for AI features on the server) ===
OPENAI_API_KEY=sk-your-openai-api-key
# Optional: override the default model / base URL
CLOUD_LLM_ENABLED=true
CLOUD_LLM_MODEL=gpt-4o-mini
CLOUD_LLM_BASE_URL=https://api.openai.com/v1

# === OPTIONAL: Telegram Bot ===
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_telegram_chat_id

# === OPTIONAL: Email / SMTP ===
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
NOTIFICATION_EMAIL=your_email@gmail.com
SENDER_NAME=BARQ

# === OPTIONAL: Job Search ===
LINKEDIN_EMAIL=your_linkedin_email
LINKEDIN_PASSWORD=your_linkedin_password
CAREER_OPS_PATH=/app/data/career-ops
RESUME_PATH=/app/data/career-ops/cv.md

# === OPTIONAL: Social Media APIs ===
YOUTUBE_API_KEY=your_youtube_api_key
TWITTER_API_KEY=your_twitter_api_key
TWITTER_API_SECRET=your_twitter_api_secret

# === OPTIONAL: API Security ===
BARQ_API_KEY=your-api-key-for-auth

# === OPTIONAL: LLM Fallback (secondary) ===
CLOUD_LLM_FALLBACK_ENABLED=false
CLOUD_LLM_FALLBACK_BASE_URL=https://api.groq.com/openai/v1
CLOUD_LLM_FALLBACK_MODEL=mixtral-8x7b-32768

# === Server Config (Fly.io injected defaults) ===
# SIDECAR_HOST=0.0.0.0                         # Injected by Dockerfile
# SIDECAR_PORT=8080                            # Matches fly.toml internal_port
# BARQ_DEBUG=false
